# Chỉ chứa cấu hình public được Vite nhúng vào bundle. KHÔNG đặt khóa bí mật ở đây.

# Rỗng = gọi REST cùng origin qua Nginx `/api` (khuyến nghị khi deploy).
VITE_API_BASE_URL=

# WebSocket phải là URL tuyệt đối. Đổi thành wss://ten-mien-cua-ban/ws khi dùng HTTPS.
VITE_WS_URL=ws://localhost:8080/ws

# `true` cho demo frontend khi Backend/AI chưa có; đặt `false` khi tích hợp thật.
VITE_USE_MOCKS=true

VITE_API_TIMEOUT_MS=20000
VITE_WS_RECONNECT_DELAY_MS=3000
